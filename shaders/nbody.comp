#version 450

layout(local_size_x = 256) in;

struct Particle {
    vec4 pos;
    vec4 vel;
};

layout(std430, set = 0, binding = 0) readonly buffer PosIn {
    Particle particlesIn[];
};

layout(std430, set = 0, binding = 1) writeonly buffer PosOut {
    Particle particlesOut[];
};

const float FRICTION = 0.08;
const float FRICTION_RANGE2 = 3600.0;

layout(push_constant) uniform SimParams {
    float dt;
    float G;
    float soft;
    uint n;
    uint bh;
    float bodySoft;
    float prevDt;
} params;

const float BH_K = 0.06;
const float DRAG = 0.15;
const float DRAG_R = 2.0;

float captureR(float m) {
    return BH_K * pow(max(m, 0.0), 1.0 / 3.0);
}

int capturer(vec3 p) {
    for (uint c = 0u; c < params.bh; ++c) {
        vec4 cp = particlesIn[c].pos;
        if (cp.w <= 0.0) continue;
        vec3 d = p - cp.xyz;
        float r = captureR(cp.w);
        if (dot(d, d) < r * r) return int(c);
    }
    return -1;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n) return;

    vec4 velIn = particlesIn[i].vel;
    if (velIn.w > 0.5) {
        vec4 parent = particlesIn[uint(velIn.w) - 1u].pos;
        vec4 parentVel = particlesIn[uint(velIn.w) - 1u].vel;
        float a = velIn.y + velIn.z * params.dt;
        vec3 centre = parent.xyz + parentVel.xyz * params.dt;
        vec3 offset = vec3(cos(a), 0.0, sin(a)) * velIn.x;
        if (uint(velIn.w) == 7u) offset = vec3(offset.x, offset.z * sin(0.47), offset.z * cos(0.47));
        particlesOut[i].pos = vec4(centre + offset, particlesIn[i].pos.w);
        particlesOut[i].vel = vec4(velIn.x, mod(a, 6.2831853), velIn.z, velIn.w);
        return;
    }

    bool collision = velIn.w < -0.1;
    vec3 pos_i = particlesIn[i].pos.xyz;
    vec3 acc = vec3(0.0);

    bool hole = params.bh != 0u;
    bool isCentre = hole && i < params.bh;
    bool merging = false;
    float m0 = particlesIn[0].pos.w;
    float m1 = params.bh == 2u ? particlesIn[1].pos.w : 0.0;
    if (hole) {
        if (particlesIn[i].pos.w <= 0.0) {
            particlesOut[i] = particlesIn[i];
            return;
        }
        if (!isCentre && capturer(pos_i) >= 0) {
            particlesOut[i].pos = vec4(pos_i, 0.0);
            particlesOut[i].vel = vec4(0.0, 0.0, 0.0, velIn.w);
            return;
        }
        if (m0 > 0.0 && m1 > 0.0) {
            vec3 dc = particlesIn[1].pos.xyz - particlesIn[0].pos.xyz;
            float rr = captureR(m0) + captureR(m1);
            merging = dot(dc, dc) < rr * rr;
        }
    }
    float capM = 0.0;
    vec3 capMom = vec3(0.0);

    for (uint j = 0u; j < params.n; ++j) {
        if (i == j) continue;
        vec3 d = particlesIn[j].pos.xyz - pos_i;
        float sf = (params.bodySoft >= 0.0 && i < 9u && j < 9u) ? params.bodySoft : params.soft;
        float distSqr = dot(d, d) + ((collision && j < 2u) ? 16.0 : sf * sf);
        float invDist = inversesqrt(distSqr);
        float invDist3 = invDist * invDist * invDist;
        acc += params.G * particlesIn[j].pos.w * d * invDist3;
        if (isCentre && j >= params.bh && particlesIn[j].pos.w > 0.0) {
            int c = capturer(particlesIn[j].pos.xyz);
            if (c == int(i) || (merging && i == 0u && c == 1)) {
                capM += particlesIn[j].pos.w;
                capMom += particlesIn[j].pos.w * particlesIn[j].vel.xyz;
            }
        }
    }

    if (hole && !isCentre) {
        for (uint c = 0u; c < params.bh; ++c) {
            vec4 cp = particlesIn[c].pos;
            if (cp.w <= 0.0) continue;
            float r = length(pos_i - cp.xyz);
            acc -= (collision ? 0.25 : 1.0) * DRAG * clamp(1.0 - r / DRAG_R, 0.0, 1.0) * (velIn.xyz - particlesIn[c].vel.xyz);
        }
    }

    if (collision && !(hole && m1 <= 0.0)) {
        uint own = i < 2u ? i : (velIn.w < -0.5 ? 1u : 0u);
        vec3 dp = particlesIn[1u - own].pos.xyz - particlesIn[own].pos.xyz;
        vec3 dv = particlesIn[own].vel.xyz - particlesIn[1u - own].vel.xyz;
        acc -= 0.5 * FRICTION * FRICTION_RANGE2 / (FRICTION_RANGE2 + dot(dp, dp)) * dv;
    }

    float kick = params.prevDt < 0.0 ? params.dt : 0.5 * (params.prevDt + params.dt);
    vec3 vel = particlesIn[i].vel.xyz + acc * kick;
    vec3 pos = pos_i + vel * params.dt;

    float mass = particlesIn[i].pos.w;
    if (isCentre) {
        if (merging && i == 1u) {
            particlesOut[i].pos = vec4(pos_i, 0.0);
            particlesOut[i].vel = vec4(0.0, 0.0, 0.0, velIn.w);
            return;
        }
        if (merging) {
            float mt = m0 + m1 + capM;
            vec3 com = (m0 * pos_i + m1 * particlesIn[1].pos.xyz) / (m0 + m1);
            vec3 v = (m0 * vel + m1 * particlesIn[1].vel.xyz + capMom) / mt;
            particlesOut[i].pos = vec4(com + v * params.dt, mt);
            particlesOut[i].vel = vec4(v, velIn.w);
            return;
        }
        vel = (mass * vel + capMom) / (mass + capM);
        pos = pos_i + vel * params.dt;
        mass += capM;
    }

    particlesOut[i].pos = vec4(pos, mass);
    particlesOut[i].vel = vec4(vel, velIn.w);
}
